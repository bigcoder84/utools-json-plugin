{
  "name": "utools-json-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "uTools JSON 编辑器：格式化、压缩、转义、折叠、去注释、JS 过滤、链接跳转与图片预览/提取",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run grammar && vite build",
    "grammar": "lezer-generator src/editor/jsonc.grammar -o src/editor/jsonc-parser.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.11"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.1",
    "@vitest/coverage-v8": "^5.0.5",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
